# ===========================================
# IQLine Design System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ===========================================
# Application
# ===========================================
# Application name displayed in the UI
VITE_APP_NAME=IQLine

# Environment (development, staging, production)
VITE_APP_ENV=development

# ===========================================
# API Configuration
# ===========================================
# Base URL for API requests
VITE_API_URL=http://localhost:3000/api

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# ===========================================
# Authentication (if using external auth)
# ===========================================
# OAuth client ID (if using OAuth)
# VITE_OAUTH_CLIENT_ID=

# OAuth redirect URI
# VITE_OAUTH_REDIRECT_URI=http://localhost:5173/callback

# ===========================================
# Feature Flags
# ===========================================
# Enable debug mode (shows additional logging)
VITE_DEBUG_MODE=false

# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false

# ===========================================
# Third-Party Services
# ===========================================
# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=

# Analytics tracking ID (optional)
# VITE_ANALYTICS_ID=

# ===========================================
# Notes
# ===========================================
# - All VITE_ prefixed variables are exposed to the client
# - Keep sensitive keys (API secrets, etc.) on the server only
# - See Vite documentation: https://vitejs.dev/guide/env-and-mode
